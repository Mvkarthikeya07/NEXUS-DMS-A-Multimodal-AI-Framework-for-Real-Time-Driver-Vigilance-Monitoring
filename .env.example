# SafeDrive AI Environment Configuration

# Twilio SMS (optional - alerts degrade gracefully without these)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
EMERGENCY_CONTACT=+1xxxxxxxxxx

# Detection Thresholds (defaults shown)
EAR_THRESHOLD=0.25
MAR_THRESHOLD=0.65
DROWSY_FRAMES=15
HEAD_TURN_THRESHOLD=0.03
PHONE_CONFIDENCE=0.30

# Alert Timing (seconds)
VOICE_ALERT_DELAY=3.0
BUZZER_ALERT_DELAY=8.0
EMERGENCY_ALERT_DELAY=13.0
DISTRACTION_ALERT_DELAY=3.0
PHONE_SMS_DELAY=5.0

# Camera
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Flask Dashboard
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
